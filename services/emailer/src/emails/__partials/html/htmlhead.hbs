<head>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    .body {
      margin: 0;
      padding: 0;
    }
    .email-body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      background-color: #f9f9f9;
      width: 100%;
      height: 100%;
      padding: 20px 0;
    }
    .email-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
    }
    .bar {
      height: 10px;
      width: 100%;
      background-color: #0a1628;
      border-bottom: 3px solid #c9a84c;
    }
    .content {
      padding: 0 20px 20px;
      margin-bottom: 20px;
      border: 1px solid #dbdbdb;
      border-top: none;
    }
    .content .header {
      margin-bottom: 40px;
    }
    .content .header .logo {
      padding: 20px 0 12px;
      font-family: Georgia, 'Palatino Linotype', serif;
      font-size: 24px;
      font-weight: bold;
      letter-spacing: 1px;
      color: #0a1628;
      border-bottom: 1px solid #e8c97a;
    }
    .content .title {
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      margin-top: 40px;
      margin-bottom: 40px;
    }
    .content p {
      margin: 0 0 20px;
    }
    .content ul {
      margin: 0 0 20px;
      padding-left: 24px;
    }
    .content li {
      margin-bottom: 8px;
    }
    p.otp {
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      margin: 40px 0;
    }
    .content a {
      color: #8a6d1f;
    }
    .cta {
      text-align: center;
      margin: 30px 0;
    }
    .cta a {
      padding: 10px 20px;
      background-color: #0a1628;
      color: #ffffff;
      text-decoration: none;
      border-radius: 4px;
      font-size: 16px;
    }
    .cta a:hover {
      background-color: #122a45;
    }
    .footer {
      text-align: center;
      font-size: 12px;
      color: #777;
      max-width: 600px;
      margin: 20px auto;
    }
  </style>
</head>
